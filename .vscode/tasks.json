{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start local web server",
      "type": "process",
      "command": "py",
      "args": ["-m", "http.server", "8080", "--bind", "127.0.0.1"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving HTTP on",
          "endsPattern": "^$"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
